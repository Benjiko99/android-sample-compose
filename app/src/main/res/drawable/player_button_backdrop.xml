<?xml version="1.0" encoding="utf-8"?>
<!-- The translucent disc behind the play/pause button, so the glyph stays legible over a bright
     frame. The mask keeps the ripple inside the circle. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/player_control_ripple">

    <item>
        <shape android:shape="oval">
            <solid android:color="@color/player_control_backdrop" />
        </shape>
    </item>

    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="@color/player_control" />
        </shape>
    </item>

</ripple>

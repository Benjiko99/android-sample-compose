<?xml version="1.0" encoding="utf-8"?>
<!--
  The "enter full screen" glyph, and the only icon in the controller we have to supply ourselves.

  media3 sets every other glyph from code as it builds the controller, but the full-screen pair is
  set only on a *change* of state: PlayerControlView.updateIsFullscreen returns early when the
  state it is handed already matches, and the state starts false. So an inline player, which never
  leaves that state, is never handed an icon and the button draws empty. The stock layout hides
  this by declaring android:src in a style; this is that declaration.

  Matches media3's own exo_ic_fullscreen_enter, so it pairs with the exit glyph the library swaps
  in on the full-screen page. app:tint on the button is what colours it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:fillColor="#FFFFFF"
        android:pathData="M7,14L5,14v5h5v-2L7,17v-3zM5,10h2L7,7h3L10,5L5,5v5zM17,17h-3v2h5v-5h-2v3zM14,5v2h3v3h2L19,5h-5z" />

</vector>
